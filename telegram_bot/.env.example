TELEGRAM_BOT_TOKEN=your_bot_token_here
OPENROUTER_API_KEY=your_api_key_here
# IMPORTANT: the model MUST support tool/function calling (the free GLM model may not).
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Backend base URL (still used by the /stats and /accounts slash commands)
BUDGET_API_BASE_URL=http://localhost:8000
# Streamable-HTTP endpoint of the Budget Planner MCP server
MCP_SERVER_URL=http://localhost:8001/mcp
# Alternative for Render/private-network deployments:
# BUDGET_API_HOST=<backend-private-host>
# BUDGET_API_PORT=<backend-port>
# MCP_SERVER_HOST=<mcp-private-host>
# MCP_SERVER_PORT=<mcp-port>
# MCP_SERVER_PATH=/mcp
LOG_LEVEL=INFO
